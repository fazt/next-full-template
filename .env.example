# Copia este archivo a .env y completa los valores.
# Solo DATABASE_URL, NEXTAUTH_URL y NEXTAUTH_SECRET son obligatorias:
# todo lo demás es opcional y tiene una alternativa local si no se define.

# ─── Base de datos (docker compose up -d) ───────────────────────────────
DATABASE_URL="postgresql://fazt:faztpassword@localhost:5461/nextdb?schema=public"

# ─── NextAuth ───────────────────────────────────────────────────────────
# URL pública de la app (también se usa en los enlaces de los correos)
NEXTAUTH_URL="http://localhost:3000"
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Login con Google (opcional). Sin estas dos variables el botón no aparece.
# Redirect URI autorizada: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Correo (recuperar contraseña) ──────────────────────────────────────
# Prioridad: Resend > SMTP > consola (en desarrollo el enlace se imprime en la terminal)
EMAIL_FROM="Next Full Template <no-reply@tudominio.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# true para el puerto 465 (por defecto se deduce del puerto)
SMTP_SECURE=""
# Minutos de validez del enlace de recuperación
PASSWORD_RESET_TTL_MINUTES="60"

# ─── Subida de archivos ─────────────────────────────────────────────────
# local (por defecto) o s3. Si eliges s3 y faltan credenciales, se usa local.
STORAGE_DRIVER="local"
UPLOAD_DIR="uploads"
UPLOAD_MAX_SIZE_MB="5"

# S3 compatible. Ejemplo para DigitalOcean Spaces (región nyc3):
#   S3_ENDPOINT="https://nyc3.digitaloceanspaces.com"
#   S3_REGION="us-east-1"
#   S3_PUBLIC_URL="https://mi-bucket.nyc3.cdn.digitaloceanspaces.com"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL base pública de los archivos (CDN). Si se omite se deduce del endpoint.
S3_PUBLIC_URL=""
# true para MinIO u otros servicios que usan rutas /bucket/clave
S3_FORCE_PATH_STYLE="false"
# public-read (Spaces). Usa "none" en buckets de AWS con las ACL desactivadas.
S3_ACL="public-read"

# ─── Notificaciones push (Web Push) ─────────────────────────────────────
# Genera las claves con: npm run vapid. Sin ellas, push queda desactivado.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@tudominio.com"

# ─── Seed ───────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin12345"
